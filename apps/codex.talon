app: codex
-

# Core navigation
[command] palette: key(ctrl-k)
settings: key(ctrl-,)
open folder: key(ctrl-o)
new thread: key(ctrl-n)
find: key(ctrl-f)

# Panels
sidebar: key(ctrl-b)
terminal: key(ctrl-j)
diff: key(ctrl-alt-b)

# Navigation between threads
next thread: key(ctrl-shift-])
previous thread: key(ctrl-shift-[)

# History navigation
back: key(ctrl-[)
forward: key(ctrl-])

# Font size
font bigger: key(ctrl-+)
font smaller: key(ctrl--)

# Terminal
clear terminal: key(ctrl-l)

# Slash commands
review:
    insert("/review")
    key(enter)

status:
    insert("/status")
    key(enter)

plan mode:
    insert("/plan-mode")
    key(enter)

feedback:
    insert("/feedback")
    key(enter)
